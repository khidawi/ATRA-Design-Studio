# Copy to .env and fill in. .env is ignored by git: never commit it.

# The database password (any long random string).
POSTGRES_PASSWORD=

# Encrypts stored secrets. Generate one with:
#   docker run --rm python:3.13-slim sh -c "pip install -q cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Keep it with your backups: without it, stored tokens and webhook addresses cannot be read again.
ASTRA_SECRET_KEY=

# The port the studio listens on. Put a reverse proxy with HTTPS in front of it (see DEPLOY.md).
ASTRA_PORT=8080

# Set to 1 only if a repository or identity provider you connect is on a private address inside your network.
ASTRA_REPO_ALLOW_PRIVATE_HOSTS=0

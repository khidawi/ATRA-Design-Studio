# Copy to .env and fill in. .env is ignored by git: never commit it.

# The database password (any long random string).
POSTGRES_PASSWORD=

# Encrypts stored secrets. Generate one with:
#   docker run --rm python:3.13-slim sh -c "pip install -q cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Keep it with your backups: without it, stored tokens and webhook addresses cannot be read again.
ASTRA_SECRET_KEY=

# The port the studio listens on. Put a reverse proxy with HTTPS in front of it (see DEPLOY.md).
ASTRA_PORT=8080

# Set to 1 only if a repository or identity provider you connect is on a private address inside your network.
ASTRA_REPO_ALLOW_PRIVATE_HOSTS=0

# ── Production (docker-compose.prod.yml: HTTPS in front, locked-down containers) ──
# The address people will use, a DNS name that points at this server, for example astra.example.org. Required by the production file.
ASTRA_DOMAIN=
# acme: a public certificate from Let's Encrypt (ports 80 and 443 must be reachable from the internet).
# internal: a certificate from Caddy's own authority, for a private name with no public DNS (see DEPLOY.md).
ASTRA_TLS=acme
# Only change these if 80 and 443 are taken on this server (then put another proxy in front on 443).
ASTRA_HTTP_PORT=80
ASTRA_HTTPS_PORT=443

# ── Production database: three identities (see DEPLOY.md, "The database") ──
# POSTGRES_PASSWORD above is the database superuser (astra_admin): used only to create the database and by backups; the application never connects as it.
# The two below are what the application uses: the owner of the tables (migrations only) and the running API (data only). They are placed in connection addresses, so use letters
# and digits only: `openssl rand -hex 24` makes one. Set them before the FIRST start: they are applied when the database is first created.
ASTRA_DB_OWNER_PASSWORD=
ASTRA_DB_APP_PASSWORD=

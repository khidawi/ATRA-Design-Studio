# Copy this file to .env — no changes needed if Ollama runs on its default
# local port with the default model.
#
# Setup (one-time):
#   1. Install Ollama: https://ollama.com/download
#   2. Pull a model that supports structured/JSON output well, e.g.:
#        ollama pull llama3.1
#   3. Ollama runs as a local background service after install — no need
#      to start it manually. Verify with: curl http://localhost:11434
#
# No API key, no per-call cost — everything runs on your own machine.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# PostgreSQL. Docker Compose sets this for you; only needed when running the backend
# outside Docker against your own database.
# DATABASE_URL=postgresql+psycopg://stai:stai@localhost:5432/stai
# DEFAULT_ORG_NAME=My organisation
